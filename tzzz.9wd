inline void ShortenSeparator(uint8_t* start, size_t& start_len,
                             BytesView limit) noexcept {
  const size_t user_len = start_len - 8;
  const BytesView user_limit = ExtractUserKey(limit);
  const size_t min_len = user_len < user_limit.size ? user_len : user_limit.size;
  const uint8_t* const lp = static_cast<const uint8_t*>(user_limit.data);
  size_t diff = 0;
  while (diff < min_len && start[diff] == lp[diff]) ++diff;
  if (diff >= min_len) return;
  const uint8_t diff_byte = start[diff];
  if (diff_byte == 0xff || diff_byte + 1 >= lp[diff]) return;
  start[diff] = static_cast<uint8_t>(diff_byte + 1);
  AppendSeekTag(start, diff + 1, start_len);
}
